/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/media/video-interfaces.h>

&{/} {
	ov5640_dovdd: regulator-ov5640-dovdd {
		compatible = "regulator-fixed";
		regulator-name = "ov5640-dovdd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	ov5640_avdd: regulator-ov5640-avdd {
		compatible = "regulator-fixed";
		regulator-name = "ov5640-avdd";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
	};

	ov5640_dvdd: regulator-ov5640-dvdd {
		compatible = "regulator-fixed";
		regulator-name = "ov5640-dvdd";
		regulator-min-microvolt = <1500000>;
		regulator-max-microvolt = <1500000>;
	};

	/* The camera module carries its own 24 MHz oscillator. */
	clk_ov5640: clock-ov5640 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};
};

&pinctrl {
	dvp1_pins: dvp1-pins {
		pins = "PC6", "PC7", "PB13", "PG11",
		       "PE4", "PB6", "PE5", "PE6",
		       "PA6", "PA4", "PB7";
		function = "dvp1";
		bias-disable;
		drive-strength = <3>;
		slew-rate = <0>;
	};
};

&cam_dma_pool {
	status = "okay";
};

&i2c4 {
	#address-cells = <1>;
	#size-cells = <0>;

	ov5640: camera@3c {
		compatible = "ovti,ov5640";
		reg = <0x3c>;
		clocks = <&clk_ov5640>;
		clock-names = "xclk";
		DOVDD-supply = <&ov5640_dovdd>;
		AVDD-supply = <&ov5640_avdd>;
		DVDD-supply = <&ov5640_dvdd>;
		ovti,max-dvp-pclk-hz = <96000000>;

		/*
		 * PC13 is RESETB.  The driver toggles a powerdown GPIO during
		 * power-up; declaring it as reset-gpios leaves this module held
		 * in reset.
		 */
		powerdown-gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
		status = "okay";

		port {
			ov5640_ep: endpoint {
				remote-endpoint = <&dvp1_ep>;
				bus-type = <MEDIA_BUS_TYPE_PARALLEL>;
				bus-width = <8>;
				hsync-active = <1>;
				vsync-active = <0>;
				pclk-sample = <1>;
			};
		};
	};
};

&dvp1 {
	pinctrl-names = "default";
	pinctrl-0 = <&dvp1_pins>;
	memory-region = <&cam_dma_pool>;
	status = "okay";

	port {
		dvp1_ep: endpoint {
			remote-endpoint = <&ov5640_ep>;
			bus-type = <MEDIA_BUS_TYPE_PARALLEL>;
			bus-width = <8>;
			/* The board input path presents the sensor syncs inverted. */
			hsync-active = <0>;
			vsync-active = <1>;
			pclk-sample = <1>;
		};
	};
};
