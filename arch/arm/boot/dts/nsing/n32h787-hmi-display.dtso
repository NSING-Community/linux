/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

&{/} {
	lcd_power: regulator-lcd {
		compatible = "regulator-fixed";
		regulator-name = "lcd-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	lcd_backlight: backlight {
		compatible = "gpio-backlight";
		gpios = <&gpioh 3 GPIO_ACTIVE_HIGH>;
	};

	panel: panel {
		compatible = "nsing,n32h787-hmi-lcd", "panel-dpi";
		power-supply = <&lcd_power>;
		enable-gpios = <&gpiob 10 GPIO_ACTIVE_HIGH>;
		backlight = <&lcd_backlight>;
		/* NTW430T40X005A / ST7262: 25 MHz, 816 x 496 total. */
		panel-timing {
			clock-frequency = <25000000>;
			hactive = <800>;
			vactive = <480>;
			hsync-len = <4>;
			hback-porch = <8>;
			hfront-porch = <4>;
			vsync-len = <4>;
			vback-porch = <8>;
			vfront-porch = <4>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <0>;
			pixelclk-active = <1>;
		};
		port {
			panel_in: endpoint {
				remote-endpoint = <&lcdc_out>;
			};
		};
	};

	/* GT911 on a bit-banged I2C1 bus, numbered from its SoC pins. */
	i2c1: i2c1 {
		compatible = "i2c-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c1_pins>;
		scl-gpios = <&gpiod 4 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		sda-gpios = <&gpiod 5 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;

		touchscreen@14 {
			compatible = "goodix,gt911";
			reg = <0x14>;
			interrupt-parent = <&gpiod>;
			interrupts = <11 IRQ_TYPE_EDGE_FALLING>;
			pinctrl-names = "default";
			pinctrl-0 = <&touch_control_pins>;
			irq-gpios = <&gpiod 11 GPIO_ACTIVE_HIGH>;
			reset-gpios = <&gpiod 6 GPIO_ACTIVE_HIGH>;
			AVDD28-supply = <&lcd_power>;
			VDDIO-supply = <&lcd_power>;
			touchscreen-size-x = <800>;
			touchscreen-size-y = <480>;
			touchscreen-inverted-x;
			touchscreen-inverted-y;
			status = "okay";
		};
	};
};

&{/aliases} {
	i2c1 = "/i2c1";
};

&pinctrl {
	lcdc_pins: lcdc-pins {
		data-pins {
			pins = "PJ1", "PJ2", "PI11", "PK3", "PK4", "PG7", "PI12", "PI13", "PK7";
			function = "lcd";
			bias-pull-up;
			drive-strength = <2>;
			slew-rate = <0>;
		};
		tolerant-data-pins {
			pins = "PJ3", "PJ4", "PJ5", "PJ6", "PJ7", "PJ8", "PJ9", "PJ10", "PJ11", "PK0", "PD3", "PJ14", "PJ15", "PB9";
			function = "lcd";
			bias-pull-up;
			drive-strength = <1>;
			slew-rate = <0>;
		};
		lcd-r0-pins {
			pins = "PI15";
			function = "lcd_r0";
			bias-pull-up;
			drive-strength = <1>;
			slew-rate = <0>;
		};
		lcd-r1-pins {
			pins = "PJ0";
			function = "lcd_r1";
			bias-pull-up;
			drive-strength = <1>;
			slew-rate = <0>;
		};
		lcd-b0-pins {
			pins = "PJ12";
			function = "lcd_b0";
			bias-pull-up;
			drive-strength = <1>;
			slew-rate = <0>;
		};
		lcd-b1-pins {
			pins = "PJ13";
			function = "lcd_b1";
			bias-pull-up;
			drive-strength = <1>;
			slew-rate = <0>;
		};
		lcd-b6-pins {
			pins = "PA15";
			function = "lcd_b6";
			bias-pull-up;
			drive-strength = <1>;
			slew-rate = <0>;
		};
	};

	lcd_control_pins: lcd-control-pins {
		pins = "PB10", "PH3";
		bias-pull-up;
		drive-strength = <2>;
		slew-rate = <0>;
	};

	i2c1_pins: i2c1-pins {
		pins = "PD4", "PD5";
		function = "gpio";
		bias-pull-up;
		drive-strength = <3>;
		slew-rate = <0>;
	};

	touch_control_pins: touch-control-pins {
		pins = "PD6", "PD11";
		function = "gpio";
		bias-pull-up;
		drive-strength = <1>;
		slew-rate = <0>;
	};
};

&graphics_dma_pool {
	status = "okay";
};

&lcdc {
	pinctrl-names = "default";
	pinctrl-0 = <&lcdc_pins &lcd_control_pins>;
	memory-region = <&graphics_dma_pool>;
	nsing,flip-horizontal;
	nsing,flip-vertical;
	status = "okay";

	port {
		lcdc_out: endpoint {
			remote-endpoint = <&panel_in>;
		};
	};
};

&gpu {
	memory-region = <&graphics_dma_pool>;
	status = "okay";
};
