// SPDX-License-Identifier: GPL-2.0-only

/dts-v1/;

/*
 * The bootloader loads the flat device tree into the "dtb" partition slot in
 * SDRAM and hands Linux the address in r2; the kernel then keeps the blob for
 * the whole run, because initial_boot_params points into it and
 * /sys/firmware/fdt hands it out verbatim.  The bootloader also makes the
 * whole slot read-only in the MPU at hand-off, so reserve the same 64 KiB
 * here: the page allocator would otherwise hand out the tail of the slot past
 * fdt_totalsize() and the first store into it would take a MemManage fault.
 *
 * The address and size here, BOOT_DTB_LOAD_ADDR and BOOT_PART_DTB_MAX in
 * bootloader/CM7/src/boot_app.c, and the bootloader's read-only MPU region
 * all describe the same slot and have to move together.  No reserved pool
 * may overlap it.
 */
/memreserve/ 0xc1e00000 0x00010000;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/media/video-interfaces.h>
#include "n32h7xx.dtsi"

/ {
	model = "NSING N32H787 HMI";
	compatible = "nsing,n32h787-hmi", "nsing,n32h787", "nsing,n32h7xx";

	chosen {
		/*
		 * The kernel carries no userland of its own any more; the root
		 * filesystem is the SquashFS image in the "rootfs" MTD partition
		 * (mtd2).  rootwait covers the SPI NOR probe finishing after the
		 * console is up.  mtdblock2 is used rather than mtd2 because the
		 * kernel needs a block device to mount a filesystem from.
		 */
		bootargs =
			"earlycon console=ttyS0,115200 root=/dev/mtdblock2 rootfstype=squashfs ro rootwait";
		stdout-path = &usart1;
	};

	aliases {
		serial0 = &usart1;
		usb0 = &usb1;
		usb1 = &usb2;
		i2c4 = &i2c4;
	};

	lcd_power: regulator-lcd {
		compatible = "regulator-fixed";
		regulator-name = "lcd-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	lcd_backlight: backlight {
		compatible = "gpio-backlight";
		gpios = <&gpioh 3 GPIO_ACTIVE_HIGH>;
	};

	panel: panel {
		compatible = "nsing,n32h787-hmi-lcd", "panel-dpi";
		power-supply = <&lcd_power>;
		enable-gpios = <&gpiob 10 GPIO_ACTIVE_HIGH>;
		backlight = <&lcd_backlight>;
		/* Same AXI / 8 and porch values as the 800x480 GPU example. */
		panel-timing {
			clock-frequency = <37500000>;
			hactive = <800>;
			vactive = <480>;
			hsync-len = <34>;
			hback-porch = <46>;
			hfront-porch = <210>;
			vsync-len = <10>;
			vback-porch = <23>;
			vfront-porch = <22>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <0>;
			pixelclk-active = <1>;
		};
		port {
			panel_in: endpoint {
				remote-endpoint = <&lcdc_out>;
			};
		};
	};

	usb2_vbus: regulator-usb2-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb2-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpiob 4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * The OV5640 module carries its own 1.8 V / 2.8 V / 1.5 V regulators,
	 * so the three sensor rails are always on and only exist to satisfy the
	 * driver's supply lookups.
	 */
	ov5640_dovdd: regulator-ov5640-dovdd {
		compatible = "regulator-fixed";
		regulator-name = "ov5640-dovdd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	ov5640_avdd: regulator-ov5640-avdd {
		compatible = "regulator-fixed";
		regulator-name = "ov5640-avdd";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
	};

	ov5640_dvdd: regulator-ov5640-dvdd {
		compatible = "regulator-fixed";
		regulator-name = "ov5640-dvdd";
		regulator-min-microvolt = <1500000>;
		regulator-max-microvolt = <1500000>;
	};

	/* The sensor module's own 24 MHz oscillator: no SoC clock is routed. */
	clk_ov5640: clock-ov5640 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	/*
	 * Bit-banged control bus on the SoC I2C4 pins (PD12/PD13).  It is
	 * shared: the WM8978 codec answers at 0x1a and an OV5640 module on
	 * either DVP connector answers at 0x3c.  The "i2c4" alias keeps the
	 * controller number Linux inherits from the pin name, so userspace
	 * sees the bus as i2c-4.
	 */
	i2c4: i2c4 {
		compatible = "i2c-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c4_pins>;
		sda-gpios = <&gpiod 13 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpiod 12 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;

		wm8978: codec@1a {
			compatible = "wlf,wm8978";
			reg = <0x1a>;
			#sound-dai-cells = <0>;
		};

		/*
		 * OV5640 camera module on the DVP1 connector.  It has no
		 * external clock input on this board: the module carries its
		 * own 24 MHz oscillator, so "xclk" is a fixed-clock stand-in
		 * that only tells the driver what rate the sensor is clocked
		 * at.  Reset is DVP1_RST on PC13 (active low).
		 *
		 * The endpoint polarity matches the sensor's own default
		 * programming: the capture port is fed a stream with HSYNC
		 * active high, VSYNC active low and the pixel clock sampled on
		 * the rising edge, which is what the DVP PORTCFG on this board
		 * is set up for.  Only the low eight data lines are wired, and
		 * they come from the sensor's D[9:2], so the bus is 8-bit.
		 */
		ov5640: camera@3c {
			compatible = "ovti,ov5640";
			reg = <0x3c>;
			clocks = <&clk_ov5640>;
			clock-names = "xclk";
			DOVDD-supply = <&ov5640_dovdd>;
			AVDD-supply = <&ov5640_avdd>;
			DVDD-supply = <&ov5640_dvdd>;
			/*
			 * Ceiling on the parallel byte clock.  The DVP receive
			 * path on this board is clean up to 96 MHz; above that
			 * the port starts truncating frames.  Modes that would
			 * ask for more are run with a slower system clock, which
			 * lowers PCLK without changing the frame geometry.
			 */
			ovti,max-dvp-pclk-hz = <96000000>;
			/*
			 * PC13 is the module's RESETB and the only camera control
			 * line wired: the module has no separate PWDN.  RESETB is
			 * active low and must be driven high before the sensor
			 * answers on SCCB.
			 *
			 * It is declared here as the powerdown line on purpose.
			 * ov5640_powerup_sequence() only ever toggles a reset line
			 * when a powerdown line is present; with reset-gpios alone
			 * it requests the line asserted (GPIOD_OUT_HIGH on an
			 * active-low reset = driven low) and never releases it,
			 * which holds this sensor in reset and makes every SCCB
			 * transfer fail.  The polarity works out in our favour:
			 * with GPIO_ACTIVE_LOW the driver's "power up" releases
			 * RESETB and its "power down" asserts it, including the
			 * t2/t3/t4 delays from the datasheet.
			 *
			 * Do not "correct" this to reset-gpios.
			 */
			powerdown-gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
			status = "okay";

			port {
				ov5640_ep: endpoint {
					remote-endpoint = <&dvp1_ep>;
					bus-type = <MEDIA_BUS_TYPE_PARALLEL>;
					bus-width = <8>;
					data-shift = <2>;
					hsync-active = <1>;
					vsync-active = <0>;
					pclk-sample = <1>;
				};
			};
		};
	};

	sound {
		compatible = "nsing,n32h787-wm8978";
		audio-cpu = <&i2s1>;
		audio-codec = <&wm8978>;
		nsing,mclk-frequency = <9375000>;
	};

	/* The bootloader loads the raw zImage+DTB at the start of the 32 MiB
	 * SDRAM window and jumps to that base address.
	 */
	memory@c0000000 {
		device_type = "memory";
		reg = <0xc0000000 0x02000000>;
	};

	/*
	 * The SoC has no IOMMU and this kernel runs without an MMU, so
	 * dma_alloc_coherent() can only succeed if a pool is reserved up
	 * front (CONFIG_DMA_GLOBAL_POOL).  dma_pool backs every on-chip DMA
	 * master that has no pool of its own: SDMMC, USB and friends.  ETH,
	 * the DVP and JPEG have their own because their buffers are much larger
	 * than the default pool.
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * Capture buffers for the DVP port.  The port writes a whole
		 * frame per buffer and there is no MMU behind it, so every
		 * buffer is one physically contiguous run; reserving the run
		 * here is what keeps it available at any point in the board's
		 * life, long after the general allocator has been chipped down
		 * to 512 KiB blocks.
		 *
		 * 2 MiB, sized from measurement rather than from the port.  FBS
		 * is a 22-bit size, so a frame *may* reach 4 MiB, but OV5640
		 * JPEG at 2592x1944 -- the only stream here that wants more
		 * than the raw formats -- comes back at 0.86-0.90 MiB in real
		 * scenes, so 2 MiB leaves better than 2x headroom and hands the
		 * other 2 MiB back to the kernel.  An overflow would not be
		 * silent: the port stops at the programmed size and raises
		 * M1OF, which the driver reports as a failed frame.
		 *
		 * This is the lowest reservation in the SDRAM band on purpose.
		 * With CAMERA=0 the node is disabled, and because nothing sits
		 * below it the 2 MiB joins the main RAM window instead of
		 * becoming an island between two reserved pools.  The no-display
		 * variant moves it to the top of the band, where the graphics
		 * pool below it no longer exists; see
		 * n32h787-hmi-no-display.dtsi.
		 *
		 * It stays clear of the bootloader's DTB slot at 0xC1E00000
		 * (BOOT_DTB_LOAD_ADDR in bootloader/CM7/src/boot_app.c).  The
		 * kernel keeps the flat tree the bootloader handed it for the
		 * whole run, so a capture must never overwrite that slot.
		 */
		cam_dma_pool: dma-pool@c1800000 {
			compatible = "shared-dma-pool";
			reg = <0xc1800000 0x00200000>;
			no-map;
		};

		/*
		 * Shared allocation bitmap for LCDC scanout and GPU GEM buffers.
		 * Kept above the capture pool so the optional pool can be given
		 * back without leaving a hole; the no-display variant removes
		 * this pool entirely instead of moving it.
		 */
		graphics_dma_pool: dma-pool@c1a00000 {
			compatible = "shared-dma-pool";
			reg = <0xc1a00000 0x00400000>;
			no-map;
		};

		/* Scanline, descriptor and coefficient storage for the JPEG codec. */
		jpeg_dma_pool: dma-pool@c1e10000 {
			compatible = "shared-dma-pool";
			reg = <0xc1e10000 0x00100000>;
			no-map;
		};

		dma_pool: dma-pool@c1f80000 {
			compatible = "shared-dma-pool";
			reg = <0xc1f80000 0x00080000>;
			no-map;
			linux,dma-default;
		};

		eth_dma_pool: dma-pool@24000000 {
			compatible = "shared-dma-pool";
			reg = <0x24000000 0x00040000>;
			no-map;
		};
	};
};

/*
 * Pin groups.  The pin controller resolves the signal name of each pin to the
 * alternate-function number that routes it, so a group reads as the wiring it
 * describes.  "function" is either a peripheral name, which picks whichever
 * signal that peripheral has on each pin, or an exact signal name.
 */
&pinctrl {
	lcdc_pins: lcdc-pins {
		data-pins {
			pins = "PJ1", "PJ2", "PI11", "PK3", "PK4", "PG7", "PI12", "PI13", "PK7";
			function = "lcd";
			bias-pull-up;
			drive-strength = <2>;
			slew-rate = <0>;
		};
		tolerant-data-pins {
			pins = "PJ3", "PJ4", "PJ5", "PJ6", "PJ7", "PJ8", "PJ9", "PJ10", "PJ11", "PK0", "PD3", "PJ14", "PJ15", "PB9";
			function = "lcd";
			bias-pull-up;
			drive-strength = <1>;
			slew-rate = <0>;
		};
		lcd-r0-pins {
			pins = "PI15";
			function = "lcd_r0";
			bias-pull-up;
			drive-strength = <1>;
			slew-rate = <0>;
		};
		lcd-r1-pins {
			pins = "PJ0";
			function = "lcd_r1";
			bias-pull-up;
			drive-strength = <1>;
			slew-rate = <0>;
		};
		lcd-b0-pins {
			pins = "PJ12";
			function = "lcd_b0";
			bias-pull-up;
			drive-strength = <1>;
			slew-rate = <0>;
		};
		lcd-b1-pins {
			pins = "PJ13";
			function = "lcd_b1";
			bias-pull-up;
			drive-strength = <1>;
			slew-rate = <0>;
		};
		lcd-b6-pins {
			pins = "PA15";
			function = "lcd_b6";
			bias-pull-up;
			drive-strength = <1>;
			slew-rate = <0>;
		};
	};

	lcd_control_pins: lcd-control-pins {
		pins = "PB10", "PH3";
		bias-pull-up;
		drive-strength = <2>;
		slew-rate = <0>;
	};

	i2c4_pins: i2c4-pins {
		pins = "PD12", "PD13";
		bias-pull-up;
		drive-strength = <3>;
	};

	audio_pins: audio-pins {
		mclk-pins {
			pins = "PA3";
			function = "i2s4_mck";
			bias-disable;
			drive-strength = <3>;
			slew-rate = <1>;
		};
		bclk-pins {
			pins = "PA5";
			function = "i2s1_ck";
			bias-disable;
			drive-strength = <0>;
			slew-rate = <1>;
		};
		ws-pins {
			pins = "PG10";
			function = "i2s1_ws";
			bias-disable;
			drive-strength = <3>;
			slew-rate = <1>;
		};
		data-pins {
			pins = "PG9";
			function = "i2s1_sdi";
			bias-disable;
			drive-strength = <3>;
			slew-rate = <1>;
		};
		dac-pins {
			pins = "PD7";
			function = "i2s1_sdo";
			bias-disable;
			drive-strength = <3>;
			slew-rate = <1>;
		};
	};
	usb1_pins: usb1-pins {
		pins = "PA11", "PA12";
		function = "usb1";
		bias-disable;
	};

	usb2_pins: usb2-pins {
		pins = "PB14", "PB15";
		function = "usb2";
		bias-disable;
	};

	/* Optional for boards with an actual ID connection; not the HMI Type-C. */
	usb2_id_pin: usb2-id-pin {
		pins = "PB12";
		function = "usb2_id";
		bias-pull-up;
	};
	usart1_pins: usart1-pins {
		pins = "PA9", "PA10";
		function = "usart1";
		bias-pull-up;
	};

	eth1_pins: eth1-pins {
		pins = "PA1", "PA2", "PA7", "PC1", "PC4", "PC5",
		       "PB11", "PG13", "PG14";
		function = "eth1";
		bias-disable;
	};

	xspi2_pins: xspi2-pins {
		pins = "PG12", "PB2", "PB0", "PF8", "PF7", "PF6";
		function = "xspi2";
		bias-disable;
		drive-strength = <3>;
		slew-rate = <0>;
	};

	sdmmc1_pins: sdmmc1-pins {
		sdmmc1-ck-pins {
			pins = "PC12";
			function = "sdmmc1_ck";
			bias-disable;
			drive-strength = <1>;
			slew-rate = <0>;
		};

		sdmmc1-data-pins {
			pins = "PD2", "PC8", "PC9", "PC10", "PC11";
			function = "sdmmc1";
			bias-pull-up;
			drive-strength = <2>;
			slew-rate = <0>;
		};
	};

	/*
	 * DVP2 parallel camera port: eight data lines, pixel clock and the two
	 * sync signals.  Every pin resolves to its one dvp2_* alternate
	 * function from the "dvp2" prefix, so the group does not have to spell
	 * the eight signal names out.
	 */
	dvp2_pins: dvp2-pins {
		pins = "PE2", "PE3", "PK5", "PK6",
		       "PI14", "PK2", "PK1", "PC3",
		       "PH5", "PH4", "PF9";
		function = "dvp2";
		bias-disable;
		drive-strength = <3>;
		slew-rate = <0>;
	};

	dvp1_pins: dvp1-pins {
		pins = "PC6", "PC7", "PB13", "PG11",
		       "PE4", "PB6", "PE5", "PE6",
		       "PA6", "PA4", "PB7";
		function = "dvp1";
		bias-disable;
		drive-strength = <3>;
		slew-rate = <0>;
	};
};

&usb1_phy {
	status = "okay";
};

&dma1 {
	status = "okay";
};

&i2s1 {
	pinctrl-names = "default";
	pinctrl-0 = <&audio_pins>;
	nsing,ws-monitor = <&gpiog 10 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&usb2_phy {
	status = "okay";
};

&usb1 {
	pinctrl-names = "default";
	pinctrl-0 = <&usb1_pins>;
	/* PA10 stays USART1 RX; the HMI board has no usable USB1 ID. */
	dr_mode = "otg";
	usb-role-switch;
	role-switch-default-mode = "peripheral";
	status = "okay";
};

&usb2 {
	pinctrl-names = "default";
	pinctrl-0 = <&usb2_pins>;
	/* R147 is NC: PB12 is not a Type-C role detector on this board. */
	dr_mode = "otg";
	usb-role-switch;
	role-switch-default-mode = "host";
	vbus-supply = <&usb2_vbus>;
	status = "okay";
};

&usart1 {
	status = "okay";

	/*
	 * PA9 is USART1_TX and PA10 is USART1_RX.  The pin controller knows
	 * which alternate function of this SoC carries each signal, so the
	 * board only has to say which signal it wants on which pin.
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&usart1_pins>;
};

&eth1 {
	status = "okay";
	memory-region = <&eth_dma_pool>;

	/*
	 * RMII to the on-board JL1111B PHY (U6, MDIO address 1).  The PHY
	 * drives the 50 MHz RMII reference clock back onto ETH_REFCLK/PA1,
	 * so the MAC is a REF_CLK consumer; there is no GTX_CLK to generate.
	 * The JL1111 page-7 RMII setup register is programmed by the PHY
	 * driver to make the PHY the clock source.
	 */
	phy-mode = "rmii";
	phy-handle = <&phy0>;

	/*
	 * RMII pin group: PA1 reference clock, PA2 MDIO, PA7 CRS_DV, PC1 MDC,
	 * PC4/PC5 RXD0/RXD1, PB11 TX_EN and PG13/PG14 TXD0/TXD1.
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&eth1_pins>;

	/* The PHY reset line is PB1 and it is active low. */
	phy-reset-gpios = <&gpiob 1 GPIO_ACTIVE_LOW>;
	phy-reset-duration = <20>;

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "nsing,n32h7xx-mdio";

		phy0: ethernet-phy@1 {
			reg = <0x1>;
		};
	};
};

&xspi2 {
	status = "okay";

	/*
	 * W25Q128 on XSPI2: single-line commands and Quad I/O reads.
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&xspi2_pins>;

	rx-sample-delay-ns = <10>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <4>;

		/*
		 * Partition table shared by the bootloader, this device tree and
		 * tools/spi_image.py: all three must agree.
		 *
		 * The bootloader reads the dtb and kernel partitions and passes
		 * the DTB address to Linux in r2.  rootfs and system are only
		 * ever reached through MTD, so the bootloader does not load them.
		 *
		 * All four partitions are writable at run time.  dtb and kernel
		 * are deliberately not "read-only": that is what lets n32-flash
		 * OTA them over the network, and it validates the image header
		 * (zImage magic / DTB magic) before erasing anything.  A new
		 * kernel or dtb only takes effect after a reboot, and a bad image
		 * is recovered through the bootloader's USB MSC mode.
		 */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "dtb";
				reg = <0x000000 0x010000>;
			};

			partition@10000 {
				label = "kernel";
				reg = <0x010000 0x400000>;
			};

			/*
			 * SquashFS is read-only by nature; the partition itself
			 * stays writable so a new rootfs can be flashed in place.
			 */
			partition@410000 {
				label = "rootfs";
				reg = <0x410000 0x300000>;
			};

			/*
			 * Size 0 means "up to the end of the flash", so system
			 * absorbs whatever the board's NOR part provides instead
			 * of pinning the layout to one device size.
			 */
			partition@710000 {
				label = "system";
				reg = <0x710000 0x000000>;
			};
		};
	};
};

&sdmmc1 {
	status = "okay";
	bus-width = <4>;
	no-1-8-v;
	no-sdio;
	no-mmc;
	broken-cd;
	disable-wp;
	/* PLL2A at 100 MHz permits the standard SD high-speed 50 MHz bus. */
	max-frequency = <50000000>;

	/* Fast edges on all six SD signals.  The drive-strength encoding in
	 * the pin group gives PC12 8 mA; encoding 2 gives PD2/PC9-PC11
	 * 4 mA and the 5 V tolerant PC8 pad 2 mA, matching the bootloader.
	 *
	 * SDMMC1 is wired to the on-board microSD slot:
	 *   PC12 CK, PD2 CMD, PC8 D0, PC9 D1, PC10 D2, PC11 D3.
	 *
	 * CMD and DAT lines need pull-ups; CK is driven by the controller.
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1_pins>;
};

/*
 * The RTC has no VBAT battery on this board: the backup domain is fed from
 * VDD, so a power cycle loses the time and a warm reset keeps it.  There is
 * nothing to configure in the device tree -- the calendar itself is set from
 * userspace once NTP has stepped the system clock.
 */
&rtc {
	status = "okay";
};

/*
 * DVP1 with the OV5640 on the camera connector.  Capture is one frame at a
 * time into a V4L2 buffer; see doc/camera.md.
 */
&dvp1 {
	pinctrl-names = "default";
	pinctrl-0 = <&dvp1_pins>;
	memory-region = <&cam_dma_pool>;
	status = "okay";

	port {
		dvp1_ep: endpoint {
			remote-endpoint = <&ov5640_ep>;
			bus-type = <MEDIA_BUS_TYPE_PARALLEL>;
			bus-width = <8>;
			hsync-active = <1>;
			vsync-active = <0>;
			pclk-sample = <1>;
		};
	};
};

/* The hardware JPEG codec is independent of camera capture. */
&jpeg {
	memory-region = <&jpeg_dma_pool>;
	status = "okay";
};

&lcdc {
	pinctrl-names = "default";
	pinctrl-0 = <&lcdc_pins &lcd_control_pins>;
	memory-region = <&graphics_dma_pool>;
	status = "okay";

	port {
		lcdc_out: endpoint {
			remote-endpoint = <&panel_in>;
		};
	};
};

&gpu {
	memory-region = <&graphics_dma_pool>;
	status = "okay";
};
