// SPDX-License-Identifier: GPL-2.0-only

/dts-v1/;

/*
 * The bootloader loads the flat device tree into the "dtb" partition slot in
 * SDRAM and hands Linux the address in r2; the kernel then keeps the blob for
 * the whole run, because initial_boot_params points into it and
 * /sys/firmware/fdt hands it out verbatim.  The bootloader also makes the
 * whole slot read-only in the MPU at hand-off, so reserve the same 64 KiB
 * here: the page allocator would otherwise hand out the tail of the slot past
 * fdt_totalsize() and the first store into it would take a MemManage fault.
 *
 * The address and size here, BOOT_DTB_LOAD_ADDR and BOOT_PART_DTB_MAX in
 * bootloader/CM7/src/boot_app.c, and the bootloader's read-only MPU region
 * all describe the same slot and have to move together.  No reserved pool
 * may overlap it.
 */
/memreserve/ 0xc1e00000 0x00010000;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include "n32h7xx.dtsi"

/ {
	model = "NSING N32H787 HMI";
	compatible = "nsing,n32h787-hmi", "nsing,n32h787", "nsing,n32h7xx";

	chosen {
		/*
		 * The kernel carries no userland of its own any more; the root
		 * filesystem is the SquashFS image in the "rootfs" MTD partition
		 * (mtd2).  rootwait covers the SPI NOR probe finishing after the
		 * console is up.  mtdblock2 is used rather than mtd2 because the
		 * kernel needs a block device to mount a filesystem from.
		 */
		bootargs =
			"earlycon console=ttyS0,115200 root=/dev/mtdblock2 rootfstype=squashfs ro rootwait";
		stdout-path = &usart1;
	};

	aliases {
		serial0 = &usart1;
		usb0 = &usb1;
		usb1 = &usb2;
		i2c4 = &i2c4;
	};

	leds {
		compatible = "gpio-leds";

		led-red {
			label = "red";
			gpios = <&gpiob 3 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_RED>;
			default-state = "off";
		};

		led-green {
			label = "green";
			gpios = <&gpiof 10 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
			default-state = "off";
		};

		led-blue {
			label = "blue";
			gpios = <&gpioi 8 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_BLUE>;
			default-state = "off";
		};
	};

	usb2_vbus: regulator-usb2-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb2-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpiob 4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * Bit-banged control bus on the SoC I2C4 pins (PD12/PD13).  It is
	 * shared: the WM8978 codec answers at 0x1a and an OV5640 module on
	 * either DVP connector answers at 0x3c.  The "i2c4" alias keeps the
	 * controller number Linux inherits from the pin name, so userspace
	 * sees the bus as i2c-4.
	 */
	i2c4: i2c4 {
		compatible = "i2c-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c4_pins>;
		sda-gpios = <&gpiod 13 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpiod 12 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;

		wm8978: codec@1a {
			compatible = "wlf,wm8978";
			reg = <0x1a>;
			#sound-dai-cells = <0>;
		};
	};

	sound {
		compatible = "nsing,n32h787-wm8978";
		audio-cpu = <&i2s1>;
		audio-codec = <&wm8978>;
		nsing,mclk-frequency = <9375000>;
	};

	/* The bootloader loads the raw zImage+DTB at the start of the 32 MiB
	 * SDRAM window and jumps to that base address.
	 */
	memory@c0000000 {
		device_type = "memory";
		reg = <0xc0000000 0x02000000>;
	};

	/*
	 * The SoC has no IOMMU and this kernel runs without an MMU, so
	 * dma_alloc_coherent() can only succeed if a pool is reserved up
	 * front (CONFIG_DMA_GLOBAL_POOL).  dma_pool backs every on-chip DMA
	 * master that has no pool of its own: SDMMC, USB and friends.  ETH,
	 * the DVP and JPEG have their own because their buffers are much larger
	 * than the default pool.
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * Optional devices allocate their large DMA pools from one
		 * contiguous band.  Each pool stays disabled here and is enabled
		 * by exactly one feature overlay, so feature combinations never
		 * need separate board DTS files or duplicate the address map.
		 */
		graphics_dma_pool: dma-pool@c1900000 {
			compatible = "shared-dma-pool";
			reg = <0xc1900000 0x00300000>;
			no-map;
			status = "disabled";
		};

		cam_dma_pool: dma-pool@c1c00000 {
			compatible = "shared-dma-pool";
			reg = <0xc1c00000 0x00200000>;
			no-map;
			status = "disabled";
		};

		/* Scanline, descriptor and coefficient storage for the JPEG codec. */
		jpeg_dma_pool: dma-pool@c1e10000 {
			compatible = "shared-dma-pool";
			reg = <0xc1e10000 0x00100000>;
			no-map;
		};

		dma_pool: dma-pool@c1f80000 {
			compatible = "shared-dma-pool";
			reg = <0xc1f80000 0x00080000>;
			no-map;
			linux,dma-default;
		};

		eth_dma_pool: dma-pool@24000000 {
			compatible = "shared-dma-pool";
			reg = <0x24000000 0x00040000>;
			no-map;
		};
	};
};

/*
 * Pin groups.  The pin controller resolves the signal name of each pin to the
 * alternate-function number that routes it, so a group reads as the wiring it
 * describes.  "function" is either a peripheral name, which picks whichever
 * signal that peripheral has on each pin, or an exact signal name.
 */
&pinctrl {
	i2c4_pins: i2c4-pins {
		pins = "PD12", "PD13";
		bias-pull-up;
		drive-strength = <3>;
	};

	audio_pins: audio-pins {
		mclk-pins {
			pins = "PA3";
			function = "i2s4_mck";
			bias-disable;
			drive-strength = <3>;
			slew-rate = <1>;
		};
		bclk-pins {
			pins = "PA5";
			function = "i2s1_ck";
			bias-disable;
			drive-strength = <0>;
			slew-rate = <1>;
		};
		ws-pins {
			pins = "PG10";
			function = "i2s1_ws";
			bias-disable;
			drive-strength = <3>;
			slew-rate = <1>;
		};
		data-pins {
			pins = "PG9";
			function = "i2s1_sdi";
			bias-disable;
			drive-strength = <3>;
			slew-rate = <1>;
		};
		dac-pins {
			pins = "PD7";
			function = "i2s1_sdo";
			bias-disable;
			drive-strength = <3>;
			slew-rate = <1>;
		};
	};
	usb1_pins: usb1-pins {
		pins = "PA11", "PA12";
		function = "usb1";
		bias-disable;
	};

	usb2_pins: usb2-pins {
		pins = "PB14", "PB15";
		function = "usb2";
		bias-disable;
	};

	/* Optional for boards with an actual ID connection; not the HMI Type-C. */
	usb2_id_pin: usb2-id-pin {
		pins = "PB12";
		function = "usb2_id";
		bias-pull-up;
	};
	usart1_pins: usart1-pins {
		pins = "PA9", "PA10";
		function = "usart1";
		bias-pull-up;
	};

	eth1_pins: eth1-pins {
		pins = "PA1", "PA2", "PA7", "PC1", "PC4", "PC5",
		       "PB11", "PG13", "PG14";
		function = "eth1";
		bias-disable;
	};

	xspi2_pins: xspi2-pins {
		pins = "PG12", "PB2", "PB0", "PF8", "PF7", "PF6";
		function = "xspi2";
		bias-disable;
		drive-strength = <3>;
		slew-rate = <0>;
	};

	sdmmc1_pins: sdmmc1-pins {
		sdmmc1-ck-pins {
			pins = "PC12";
			function = "sdmmc1_ck";
			bias-disable;
			drive-strength = <1>;
			slew-rate = <0>;
		};

		sdmmc1-data-pins {
			pins = "PD2", "PC8", "PC9", "PC10", "PC11";
			function = "sdmmc1";
			bias-pull-up;
			drive-strength = <2>;
			slew-rate = <0>;
		};
	};

};

&usb1_phy {
	status = "okay";
};

&dma1 {
	status = "okay";
};

&i2s1 {
	pinctrl-names = "default";
	pinctrl-0 = <&audio_pins>;
	nsing,ws-monitor = <&gpiog 10 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&usb2_phy {
	status = "okay";
};

&usb1 {
	pinctrl-names = "default";
	pinctrl-0 = <&usb1_pins>;
	/* PA10 stays USART1 RX; the HMI board has no usable USB1 ID. */
	dr_mode = "otg";
	usb-role-switch;
	role-switch-default-mode = "peripheral";
	status = "okay";
};

&usb2 {
	pinctrl-names = "default";
	pinctrl-0 = <&usb2_pins>;
	/* R147 is NC: PB12 is not a Type-C role detector on this board. */
	dr_mode = "otg";
	usb-role-switch;
	role-switch-default-mode = "host";
	vbus-supply = <&usb2_vbus>;
	status = "okay";
};

&usart1 {
	status = "okay";

	/*
	 * PA9 is USART1_TX and PA10 is USART1_RX.  The pin controller knows
	 * which alternate function of this SoC carries each signal, so the
	 * board only has to say which signal it wants on which pin.
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&usart1_pins>;
};

&eth1 {
	status = "okay";
	memory-region = <&eth_dma_pool>;

	/*
	 * RMII to the on-board JL1111B PHY (U6, MDIO address 1).  The PHY
	 * drives the 50 MHz RMII reference clock back onto ETH_REFCLK/PA1,
	 * so the MAC is a REF_CLK consumer; there is no GTX_CLK to generate.
	 * The JL1111 page-7 RMII setup register is programmed by the PHY
	 * driver to make the PHY the clock source.
	 */
	phy-mode = "rmii";
	phy-handle = <&phy0>;

	/*
	 * RMII pin group: PA1 reference clock, PA2 MDIO, PA7 CRS_DV, PC1 MDC,
	 * PC4/PC5 RXD0/RXD1, PB11 TX_EN and PG13/PG14 TXD0/TXD1.
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&eth1_pins>;

	/* The PHY reset line is PB1 and it is active low. */
	phy-reset-gpios = <&gpiob 1 GPIO_ACTIVE_LOW>;
	phy-reset-duration = <20>;

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "nsing,n32h7xx-mdio";

		phy0: ethernet-phy@1 {
			reg = <0x1>;
		};
	};
};

&xspi2 {
	status = "okay";

	/*
	 * W25Q128 on XSPI2: single-line commands and Quad I/O reads.
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&xspi2_pins>;

	rx-sample-delay-ns = <10>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <4>;

		/*
		 * Partition table shared by the bootloader, this device tree and
		 * tools/spi_image.py: all three must agree.
		 *
		 * The bootloader reads the dtb and kernel partitions and passes
		 * the DTB address to Linux in r2.  rootfs and system are only
		 * ever reached through MTD, so the bootloader does not load them.
		 *
		 * All four partitions are writable at run time.  dtb and kernel
		 * are deliberately not "read-only": that is what lets n32-flash
		 * OTA them over the network, and it validates the image header
		 * (zImage magic / DTB magic) before erasing anything.  A new
		 * kernel or dtb only takes effect after a reboot, and a bad image
		 * is recovered through the bootloader's USB MSC mode.
		 */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "dtb";
				reg = <0x000000 0x010000>;
			};

			partition@10000 {
				label = "kernel";
				reg = <0x010000 0x400000>;
			};

			/*
			 * SquashFS is read-only by nature; the partition itself
			 * stays writable so a new rootfs can be flashed in place.
			 */
			partition@410000 {
				label = "rootfs";
				reg = <0x410000 0x300000>;
			};

			/*
			 * Size 0 means "up to the end of the flash", so system
			 * absorbs whatever the board's NOR part provides instead
			 * of pinning the layout to one device size.
			 */
			partition@710000 {
				label = "system";
				reg = <0x710000 0x000000>;
			};
		};
	};
};

&sdmmc1 {
	status = "okay";
	bus-width = <4>;
	no-1-8-v;
	no-sdio;
	no-mmc;
	broken-cd;
	disable-wp;
	/* PLL2A at 100 MHz permits the standard SD high-speed 50 MHz bus. */
	max-frequency = <50000000>;

	/* Fast edges on all six SD signals.  The drive-strength encoding in
	 * the pin group gives PC12 8 mA; encoding 2 gives PD2/PC9-PC11
	 * 4 mA and the 5 V tolerant PC8 pad 2 mA, matching the bootloader.
	 *
	 * SDMMC1 is wired to the on-board microSD slot:
	 *   PC12 CK, PD2 CMD, PC8 D0, PC9 D1, PC10 D2, PC11 D3.
	 *
	 * CMD and DAT lines need pull-ups; CK is driven by the controller.
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1_pins>;
};

/*
 * The RTC has no VBAT battery on this board: the backup domain is fed from
 * VDD, so a power cycle loses the time and a warm reset keeps it.  There is
 * nothing to configure in the device tree -- the calendar itself is set from
 * userspace once NTP has stepped the system clock.
 */
&rtc {
	status = "okay";
};

/* The hardware JPEG codec is independent of camera capture. */
&jpeg {
	memory-region = <&jpeg_dma_pool>;
	status = "okay";
};
