# CONFIG_MMU is not set
CONFIG_BLK_DEV_INITRD=y
# Empty on purpose: the userland is a separate SquashFS partition (mtd2) that the
# kernel mounts via the DTB bootargs, so the kernel must not embed a copy of it.
# Leaving this set to the mach-nsing tree silently doubled the userland in ROM
# (once in zImage, once in the rootfs partition).  Empty is not the same as "no
# initramfs": kbuild falls back to usr/default_cpio_list (a ~1 KiB list that only
# carries /dev/console), which console_on_rootfs() needs before devtmpfs appears.
CONFIG_INITRAMFS_SOURCE=""
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# The built-in cpio is uncompressed; no external initrd is loaded.
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
# CONFIG_XZ_DEC is not set

CONFIG_ARCH_NSING=y
CONFIG_SOC_N32H7XX=y
CONFIG_CPU_V7M_NUM_IRQ=240
CONFIG_CPU_V7M_FPU=y

CONFIG_SET_MEM_PARAM=y
CONFIG_DRAM_BASE=0xc0000000
CONFIG_DRAM_SIZE=0x02000000
# CONFIG_XIP_KERNEL is not set
# The bootloader passes the separate DTB partition in r2.
# CONFIG_ARM_APPENDED_DTB is not set

CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT=y
CONFIG_LOG_BUF_SHIFT=16
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
