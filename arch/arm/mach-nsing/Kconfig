menuconfig ARCH_NSING
	bool "NSING SoC support"
	depends on ARM_SINGLE_ARMV7M
	select ARMV7M_SYSTICK_CLOCKEVENT
	select CLKSRC_MMIO
	select RESET_CONTROLLER
	help
	  Support for NSING SoCs.  The current N32H7xx family uses a
	  Cortex-M7 core and boots Linux with the ARMv7-M NOMMU port.
	  Enable this to build platform support for boards using these SoCs.
	  Individual peripheral drivers are selected separately.

if ARCH_NSING

config SOC_N32H7XX
	bool "NSING N32H7xx family"
	default y
	help
	  Support for the NSING N32H7xx family.  N32H787 is the first
	  supported member and combines a Cortex-M7 with a Cortex-M4.
	  Linux runs on the Cortex-M7 and uses external SDRAM for memory.
	  The Cortex-M4 remains reset-held by default and can optionally be
	  managed by N32H7XX_CM4_RPROC.

config ARMV7M_SYSTICK_CLOCKEVENT
	bool
	help
	  Select the ARMv7-M SysTick exception entry for a platform-provided
	  clock event driver.

config SERIAL_N32H7XX
	bool "NSING N32H7xx USART serial and console support"
	depends on TTY
	select SERIAL_CORE
	select SERIAL_CORE_CONSOLE
	select SERIAL_EARLYCON
	help
	  Support for the NSING N32H7xx USART.  The driver lives under
	  mach-nsing because the register block is SoC-private and is not a
	  generic 8250/PL011-compatible UART.
	  It provides the serial console and early boot console on USART1.

config N32H7XX_CM4_RPROC
	bool "NSING N32H7xx Cortex-M4 remoteproc support"
	select REMOTEPROC
	select REMOTEPROC_CDEV
	help
	  Manage the N32H7xx Cortex-M4 from Linux through the remoteproc
	  framework.  Firmware is loaded into the CM4 AHB SRAM window and
	  started only after userspace explicitly requests it.

	  The bootloader must leave the CM4 in reset.  This driver refuses to
	  take ownership of a CM4 that another boot stage has already released.

endif
