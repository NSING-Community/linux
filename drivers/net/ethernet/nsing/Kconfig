# NSING network device configuration
#

config NET_VENDOR_NSING
	bool "NSING devices"
	default y
	depends on ARCH_NSING
	help
	  If you have a network (Ethernet) card belonging to this class, say Y.

	  Note that the answer to this question doesn't directly affect the
	  kernel: saying N will just cause the configurator to skip all the
	  questions about NSING cards. If you say Y, you will be asked for your
	  specific card in the following questions.

if NET_VENDOR_NSING

config N32H7XX_ETH
	tristate "NSING N32H7xx on-chip Ethernet MAC"
	default ARCH_NSING
	depends on OF && PHYLIB && OF_MDIO
	help
	  Support for the Ethernet MAC integrated in NSING N32H7xx SoCs.

	  The driver programs the MAC, MTL and DMA blocks directly and talks to
	  the board PHY through the MAC's own MDIO controller.  The clock gates,
	  reset, AFIO interface select and pin muxing are SoC properties and are
	  handled by the mach-nsing code.

endif # NET_VENDOR_NSING
